# dependencies
node_modules/

# runtime database artifacts (large, regenerated by memory-eternal)
*.db
*.db-shm
*.db-wal

# break first-cut backup copies (regenerated on first write)
*.bak

# live vault copy kept under _smoke for manual probing
_smoke/vault-live/

# generated 7-section fixture (reproducible via test/make-7s-fixture.mjs)
_smoke/sample-7s.exe

# runtime state (first run recreates it; may hold a signed agreement)
data/

# local UI probe artifacts: screenshots and logs stay out, the harness script is tracked
_ui-test/shots-*/
_ui-test/*.txt
_ui-test/*.exe

# break journal directories created during probes
*.purge/

# generated acceptance logs (regenerated by the suites)
test/ux2layer-results.txt
test/ux2layer-ui-results.txt

# local archive of deleted docs (kept for recovery, not tracked)
_archive/

# npm token (written temporarily by scripts/publish.mjs)
.npmrc

# 演练/侦察证据（含目标侧敏感信息，只留本机）
runs/

# 临时调试脚本
_probe/

# 打包产物
*.tgz
