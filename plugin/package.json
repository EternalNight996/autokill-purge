{
  "name": "autokill-purge-plugin",
  "version": "0.4.4",
  "description": "梦神（YG）· 梦神破甲 · autokill-purge 的宿主内装备插件：58 个 redteam_* 工具、演练台事实库、预设/技能落地、审批/沙箱/裁剪的进程内接管（内化 dsh-purge 内核）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./redteam": {
      "default": "./vendor/lib/redteam/index.js"
    },
    "./redteam/store": {
      "default": "./vendor/lib/redteam/store.js"
    },
    "./redteam/tools": {
      "default": "./vendor/lib/redteam/tools.js"
    },
    "./redteam/ui": {
      "default": "./vendor/lib/redteam/ui.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "vendor",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "dshTarget": "0.2.2-rc.5"
}
